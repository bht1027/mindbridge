# Required for live CLI, Streamlit demo, and LLM-judge evaluation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.3

# Runtime display and retrieval settings.
SHOW_INTERMEDIATE=true
SUPPORT_KB_PATH=data/support_kb.json
RETRIEVAL_TOP_K=3
MEMORY_WINDOW=4
RESPONSE_STYLE=conversational
# true = CBT-informed reflective flow; false = lighter assistant flow
THERAPIST_FLOW_STRICT=true

# Persistent profile memory for CLI chat and Streamlit demo.
PERSISTENT_MEMORY_ENABLED=true
PERSISTENT_MEMORY_PATH=data/user_profiles.json
PERSISTENT_HISTORY_LIMIT=200
